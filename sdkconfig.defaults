# Waveshare ESP32-S3-AUDIO-Board : ESP32-S3R8, 16 Mo de flash, 8 Mo de PSRAM octale.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Wi-Fi : le son circule en continu, sans économie d'énergie qui ajouterait de la latence.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Envoi du micro en continu (32 Ko/s chiffrés) : tampons TCP plus larges que par défaut.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
# Envoi du micro et réception de la voix en même temps : un verrou d'envoi à part, pour que
# l'un n'attende pas l'autre.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
